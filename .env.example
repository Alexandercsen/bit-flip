# Contact form email delivery
CONTACT_EMAIL=bitflipireland@gmail.com

# Gmail App Password (recommended). Without this, FormSubmit fallback is used.
# 1. Google Account → Security → 2-Step Verification (on)
# 2. App passwords → create one for "Mail"
# 3. Paste the 16-character password below (spaces optional)
# On Vercel/hosting: set these same keys in the project Environment Variables.
CONTACT_EMAIL_APP_PASSWORD=
